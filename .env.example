# Jev (TypeSafe AI) — https://typesafe.ai
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=
MODEL_SMALL=claude-haiku-4-5
MODEL_LARGE=claude-sonnet-4-5

# Jira Cloud — token en https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://TU-SITIO.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=DEMO
JIRA_TEAM_FIELD_ID=customfield_10050   # id del campo custom "Equipo"

# Servidor
PORT=3000

# Leads de Jira (accountId). Opcionales: sin ellos solo se clasifica, no se asigna.
LEAD_PAGOS=
LEAD_PLATAFORMA=
LEAD_FRONTEND=
LEAD_DATOS=
LEAD_TRIAGE=

# Umbrales (opcionales; defaults en shared/thresholds.ts)
# THRESHOLD_APPLY=0.70
# THRESHOLD_FLAG=0.50
# THRESHOLD_HUMAN=0.50
# ROUTER_MIN_CONFIDENCE=0.60
# ROUTER_MONEY_THRESHOLD=0.50
# JEV_PRICE_PER_M=0.10

# Solo para el webhook de GitHub en tu fork (opcional)
GITHUB_TOKEN=

# Mocks para ensayar sin llaves (o usa --mock en cada comando)
# JEV_MOCK=1
# ANTHROPIC_MOCK=1
# JIRA_MOCK=1
# Umbral del pre-vuelo (acto 2): desde qué probabilidad una señal de Jev cuenta como marca
# SCAN_THRESHOLD=0.60
